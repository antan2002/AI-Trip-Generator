PORT=8080

# MongoDB connection string (MongoDB Atlas). NOTE: the code reads MONGO_CONN, not MONGO_URI.
MONGO_CONN=mongodb+srv://<dbuser>:<dbpassword>@<cluster-host>/<dbname>?retryWrites=true&w=majority

# Any long random string. Used to sign and verify JWTs.
JWT_SECRET=change-me-to-a-long-random-string
